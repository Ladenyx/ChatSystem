{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chatsystem.local/schemas/admin-analytics.schema.json",
  "title": "Admin Overview, User Creation, and Analytics Payloads",
  "description": "JSON Schema for A-SCR-02, A-DLG-01 creation result, A-SCR-07, A-SCR-08, and A-SCR-09.",
  "type": "object",
  "oneOf": [
    { "$ref": "#/$defs/AdminOverviewDto" },
    { "$ref": "#/$defs/AdminMonthlySeriesDto" },
    { "$ref": "#/$defs/AdminFriendNetworkResponse" },
    { "$ref": "#/$defs/AdminCreateUserResponse" }
  ],
  "$defs": {
    "MonthlyCountPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["year", "month", "count"],
      "properties": {
        "year": { "type": "integer" },
        "month": { "type": "integer", "minimum": 1, "maximum": 12 },
        "count": { "type": "integer", "minimum": 0 }
      }
    },
    "OrderedMonthlyPoints": {
      "type": "array",
      "description": "Exactly 12 monthly points ordered T1..T12; cross-field year equality against the enclosing `year` is enforced by the DTO/Server.",
      "minItems": 12,
      "maxItems": 12,
      "items": false,
      "prefixItems": [
        { "allOf": [{ "$ref": "#/$defs/MonthlyCountPoint" }, { "properties": { "month": { "const": 1 } } }] },
        { "allOf": [{ "$ref": "#/$defs/MonthlyCountPoint" }, { "properties": { "month": { "const": 2 } } }] },
        { "allOf": [{ "$ref": "#/$defs/MonthlyCountPoint" }, { "properties": { "month": { "const": 3 } } }] },
        { "allOf": [{ "$ref": "#/$defs/MonthlyCountPoint" }, { "properties": { "month": { "const": 4 } } }] },
        { "allOf": [{ "$ref": "#/$defs/MonthlyCountPoint" }, { "properties": { "month": { "const": 5 } } }] },
        { "allOf": [{ "$ref": "#/$defs/MonthlyCountPoint" }, { "properties": { "month": { "const": 6 } } }] },
        { "allOf": [{ "$ref": "#/$defs/MonthlyCountPoint" }, { "properties": { "month": { "const": 7 } } }] },
        { "allOf": [{ "$ref": "#/$defs/MonthlyCountPoint" }, { "properties": { "month": { "const": 8 } } }] },
        { "allOf": [{ "$ref": "#/$defs/MonthlyCountPoint" }, { "properties": { "month": { "const": 9 } } }] },
        { "allOf": [{ "$ref": "#/$defs/MonthlyCountPoint" }, { "properties": { "month": { "const": 10 } } }] },
        { "allOf": [{ "$ref": "#/$defs/MonthlyCountPoint" }, { "properties": { "month": { "const": 11 } } }] },
        { "allOf": [{ "$ref": "#/$defs/MonthlyCountPoint" }, { "properties": { "month": { "const": 12 } } }] }
      ]
    },
    "AdminRecentSpamReport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "reportedUserId",
        "reportedUsername",
        "reporterUserId",
        "reporterUsername",
        "receivedAt",
        "reviewStatus"
      ],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "reportedUserId": { "type": "string", "format": "uuid" },
        "reportedUsername": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "reporterUserId": { "type": "string", "format": "uuid" },
        "reporterUsername": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "receivedAt": { "type": "string", "format": "date-time" },
        "reviewStatus": { "type": "string", "enum": ["PENDING", "REVIEWED"] }
      }
    },
    "AdminLoginHistoryItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "userId", "username", "fullName", "loggedInAt", "scope"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "userId": { "type": ["string", "null"], "format": "uuid" },
        "username": { "type": ["string", "null"] },
        "fullName": { "type": ["string", "null"] },
        "loggedInAt": { "type": "string", "format": "date-time" },
        "scope": { "type": "string", "enum": ["USER_CLIENT", "ADMIN_APP"] }
      }
    },
    "AdminOverviewDto": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "totalUsers",
        "onlineUsers",
        "totalGroups",
        "pendingSpamReports",
        "year",
        "asOfDate",
        "monthlyRegistrations",
        "monthlyActiveUsers",
        "recentSpamReports",
        "recentLogins"
      ],
      "properties": {
        "totalUsers": { "type": "integer", "minimum": 0 },
        "onlineUsers": { "type": "integer", "minimum": 0 },
        "totalGroups": { "type": "integer", "minimum": 0 },
        "pendingSpamReports": { "type": "integer", "minimum": 0 },
        "year": { "type": "integer" },
        "asOfDate": { "type": "string", "format": "date" },
        "monthlyRegistrations": { "$ref": "#/$defs/OrderedMonthlyPoints" },
        "monthlyActiveUsers": { "$ref": "#/$defs/OrderedMonthlyPoints" },
        "recentSpamReports": {
          "type": "array",
          "maxItems": 3,
          "items": { "$ref": "#/$defs/AdminRecentSpamReport" }
        },
        "recentLogins": {
          "type": "array",
          "maxItems": 3,
          "items": { "$ref": "#/$defs/AdminLoginHistoryItem" }
        }
      }
    },
    "AdminMonthlySeriesDto": {
      "type": "object",
      "additionalProperties": false,
      "required": ["year", "asOfDate", "availableYears", "points"],
      "properties": {
        "year": { "type": "integer" },
        "asOfDate": { "type": "string", "format": "date" },
        "availableYears": {
          "type": "array",
          "items": { "type": "integer" }
        },
        "points": { "$ref": "#/$defs/OrderedMonthlyPoints" }
      }
    },
    "AdminFriendNetworkResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currentAccounts", "connectedAccounts", "page"],
      "properties": {
        "currentAccounts": { "type": "integer", "minimum": 0 },
        "connectedAccounts": { "type": "integer", "minimum": 0 },
        "page": {
          "type": "object",
          "additionalProperties": false,
          "required": ["items", "page", "size", "totalItems", "totalPages"],
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["userId", "username", "fullName", "createdAt", "directFriends", "extendedFriends"],
                "properties": {
                  "userId": { "type": "string", "format": "uuid" },
                  "username": { "type": "string" },
                  "fullName": { "type": "string" },
                  "createdAt": { "type": "string", "format": "date-time" },
                  "directFriends": { "type": "integer", "minimum": 0 },
                  "extendedFriends": { "type": "integer", "minimum": 0 }
                }
              }
            },
            "page": { "type": "integer", "minimum": 0 },
            "size": { "type": "integer", "minimum": 1, "maximum": 100 },
            "totalItems": { "type": "integer", "minimum": 0 },
            "totalPages": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "AdminCreateUserResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["user", "activationEmailSent", "emailDeliveryError"],
      "properties": {
        "user": {
          "$ref": "admin-users.schema.json#/$defs/AdminUserDetail"
        },
        "activationEmailSent": { "type": "boolean" },
        "emailDeliveryError": { "type": ["string", "null"] }
      },
      "oneOf": [
        {
          "properties": {
            "activationEmailSent": { "const": true },
            "emailDeliveryError": { "type": "null" }
          }
        },
        {
          "properties": {
            "activationEmailSent": { "const": false },
            "emailDeliveryError": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        }
      ]
    }
  }
}
