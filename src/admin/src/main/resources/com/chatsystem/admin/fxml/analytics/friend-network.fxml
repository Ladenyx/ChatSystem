<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<ScrollPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.chatsystem.admin.controller.analytics.FriendNetworkController"
            stylesheets="@../../css/analytics.css" styleClass="admin-analytics-view"
            minWidth="0" fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER">
    <VBox spacing="12" minWidth="0" styleClass="admin-analytics-content">
        <fx:include fx:id="chart" source="monthly-chart.fxml"/>
        <VBox spacing="12" minWidth="0" styleClass="admin-analytics-panel" VBox.vgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT" spacing="16">
                <Label text="Mạng lưới hiện tại" styleClass="section-title"/>
                <Label fx:id="networkCount" styleClass="caption" visible="false" managed="false"/>
                <Region HBox.hgrow="ALWAYS"/>
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label fx:id="currentAccounts" styleClass="admin-analytics-inline-number"/>
                    <Label text="tài khoản chưa bị xóa" styleClass="caption"/>
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label fx:id="connectedAccounts" styleClass="admin-analytics-inline-number"/>
                    <Label text="có bạn trực tiếp" styleClass="caption"/>
                </HBox>
            </HBox>
            <fx:include fx:id="filters" source="filters.fxml"/>
            <TableView fx:id="networkRows" styleClass="admin-analytics-table" prefHeight="220"
                       minWidth="0" minHeight="144" fixedCellSize="36" VBox.vgrow="ALWAYS"
                       accessibleText="Quy mô mạng lưới theo tài khoản">
                <columns>
                    <TableColumn fx:id="accountId" text="ID" minWidth="76" prefWidth="88"
                                 styleClass="admin-analytics-meta" sortable="false" reorderable="false"/>
                    <TableColumn fx:id="fullName" text="Họ tên" minWidth="126" prefWidth="186"
                                 sortable="false" reorderable="false"/>
                    <TableColumn fx:id="createdAt" text="Ngày tạo" minWidth="140" prefWidth="168"
                                 styleClass="admin-analytics-meta" sortable="false" reorderable="false"/>
                    <TableColumn fx:id="directFriends" text="Bạn trực tiếp" minWidth="112" prefWidth="140"
                                 styleClass="admin-analytics-metric" sortable="false" reorderable="false"/>
                    <TableColumn fx:id="extendedFriends" text="Tổng bạn mở rộng" minWidth="164" prefWidth="192"
                                 sortable="false" reorderable="false"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS"/>
                </columnResizePolicy>
                <placeholder><Label text="Không có tài khoản khớp bộ lọc" styleClass="secondary-text"/></placeholder>
            </TableView>
            <Label text="Tỷ lệ bạn trực tiếp trên tổng bạn mở rộng" styleClass="caption" wrapText="true"/>
        </VBox>
    </VBox>
</ScrollPane>
