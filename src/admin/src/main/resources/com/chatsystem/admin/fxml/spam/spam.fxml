<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<SplitPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.chatsystem.admin.controller.spam.SpamController"
           dividerPositions="0.52" styleClass="admin-users-page,admin-spam-page" stylesheets="@../../css/spam.css"
           accessibleText="Danh sách và kiểm duyệt báo cáo spam" focusTraversable="false">
    <StackPane.margin><Insets top="16" right="24" bottom="16" left="24"/></StackPane.margin>
    <fx:define>
        <ToggleGroup fx:id="statusFilters"/>
    </fx:define>

    <VBox spacing="12" minWidth="360" styleClass="admin-user-directory,admin-spam-directory">
        <HBox spacing="8" alignment="CENTER_LEFT">
            <VBox spacing="2">
                <Label text="Kiểm duyệt báo cáo spam" styleClass="section-title" wrapText="true"/>
                <Label text="Hồ sơ gốc trong hạn lưu 180 ngày (DEC-10)" styleClass="caption"/>
            </VBox>
        </HBox>

        <GridPane hgap="8" vgap="4">
            <columnConstraints>
                <ColumnConstraints percentWidth="50"/>
                <ColumnConstraints percentWidth="50"/>
            </columnConstraints>
            <VBox spacing="2" GridPane.rowIndex="0" GridPane.columnIndex="0">
                <Label text="Từ ngày" styleClass="caption"/>
                <DatePicker fx:id="startDateFilter" id="startDateFilter" promptText="DD/MM/YYYY" maxWidth="Infinity"/>
            </VBox>
            <VBox spacing="2" GridPane.rowIndex="0" GridPane.columnIndex="1">
                <Label text="Đến ngày" styleClass="caption"/>
                <DatePicker fx:id="endDateFilter" id="endDateFilter" promptText="DD/MM/YYYY" maxWidth="Infinity"/>
            </VBox>
        </GridPane>

        <HBox spacing="8" alignment="CENTER_LEFT">
            <TextField fx:id="reportedUserFilter" id="reportedUserFilter" promptText="Tìm theo tài khoản bị báo cáo..."
                       minWidth="0" HBox.hgrow="ALWAYS" styleClass="admin-search-input"/>
            <ComboBox fx:id="sortOrder" id="spamSortOrder" minWidth="160" prefWidth="180"/>
        </HBox>

        <FlowPane hgap="4" vgap="4" prefWrapLength="332" maxWidth="-Infinity"
                  styleClass="admin-user-filters" accessibleText="Lọc theo trạng thái xử lý">
            <ToggleButton fx:id="allReports" id="allReports" text="Tất cả" toggleGroup="$statusFilters" selected="true"/>
            <ToggleButton fx:id="pendingReports" id="pendingReports" text="Chờ xử lý" toggleGroup="$statusFilters"/>
            <ToggleButton fx:id="reviewedReports" id="reviewedReports" text="Đã xử lý" toggleGroup="$statusFilters"/>
        </FlowPane>

        <TableView fx:id="reportsTable" id="reportsTable" fixedCellSize="48" minWidth="0" minHeight="144"
                   styleClass="admin-users-table,admin-directory-table" accessibleText="Danh sách báo cáo spam"
                   VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="reportedUserColumn" text="Tài khoản bị báo cáo" minWidth="140" prefWidth="180"
                             reorderable="false"/>
                <TableColumn fx:id="reporterColumn" text="Người báo cáo" minWidth="120" prefWidth="150"
                             sortable="false" reorderable="false"/>
                <TableColumn fx:id="reportedAtColumn" text="Thời gian" minWidth="135" prefWidth="140"
                             styleClass="admin-date-column" reorderable="false"/>
                <TableColumn fx:id="statusColumn" text="Trạng thái" minWidth="90" prefWidth="100"
                             sortable="false" reorderable="false"/>
            </columns>
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_NEXT_COLUMN"/></columnResizePolicy>
            <placeholder>
                <Label text="Không tìm thấy báo cáo phù hợp" styleClass="secondary-text" wrapText="true"/>
            </placeholder>
        </TableView>

        <HBox spacing="8" alignment="CENTER_LEFT" minHeight="28">
            <Label fx:id="reportCount" id="reportCount" styleClass="caption"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Hyperlink fx:id="clearFilters" id="clearSpamFilters" text="Xóa bộ lọc" onAction="#clearFilters"/>
        </HBox>
    </VBox>

    <StackPane minWidth="316" styleClass="admin-inspector-panel">
        <VBox fx:id="unselectedReport" id="unselectedReport" alignment="CENTER" spacing="12" styleClass="admin-inspector-empty">
            <StackPane styleClass="admin-inspector-icon">
                <FontIcon iconLiteral="fth-shield" iconSize="20"/>
            </StackPane>
            <Label text="Chọn báo cáo spam để xem chi tiết bằng chứng và kiểm duyệt" styleClass="secondary-text"
                   wrapText="true" textAlignment="CENTER"/>
        </VBox>

        <ScrollPane fx:id="reportInspector" id="reportInspector" fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER"
                    minWidth="0" visible="false" managed="false" focusTraversable="false"
                    styleClass="admin-user-inspector">
            <VBox spacing="16" minWidth="0" styleClass="admin-profile-content">
                <VBox spacing="12" minWidth="0" styleClass="admin-profile-summary">
                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <VBox spacing="4" minWidth="0" HBox.hgrow="ALWAYS">
                            <HBox alignment="CENTER_LEFT" spacing="8">
                                <Label fx:id="reportIdTitle" id="reportIdTitle" styleClass="admin-profile-name" wrapText="true"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label fx:id="reportStatusBadge" id="reportStatusBadge"/>
                            </HBox>
                            <Label fx:id="reportTimestamp" id="reportTimestamp" styleClass="caption,admin-account-meta" wrapText="true"/>
                        </VBox>
                    </HBox>

                    <GridPane hgap="12" vgap="8" minWidth="0" styleClass="admin-parties-grid">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="50"/>
                            <ColumnConstraints percentWidth="50"/>
                        </columnConstraints>
                        <VBox spacing="4" styleClass="admin-party-box">
                            <Label text="Người gửi báo cáo" styleClass="caption,admin-party-label"/>
                            <Label fx:id="reporterName" id="reporterName" styleClass="admin-party-name" wrapText="true"/>
                            <Label fx:id="reporterUsername" id="reporterUsername" styleClass="caption"/>
                            <Label fx:id="reporterId" id="reporterId" styleClass="caption,admin-account-meta"/>
                        </VBox>
                        <VBox spacing="4" GridPane.columnIndex="1" styleClass="admin-party-box,party-reported">
                            <HBox alignment="CENTER_LEFT" spacing="6">
                                <Label text="Tài khoản bị báo cáo" styleClass="caption,admin-party-label"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label fx:id="reportedUserStatus" id="reportedUserStatus"/>
                            </HBox>
                            <Label fx:id="reportedName" id="reportedName" styleClass="admin-party-name" wrapText="true"/>
                            <Label fx:id="reportedUsername" id="reportedUsername" styleClass="caption"/>
                            <Label fx:id="reportedId" id="reportedId" styleClass="caption,admin-account-meta"/>
                        </VBox>
                    </GridPane>

                    <VBox spacing="4" styleClass="admin-reason-box">
                        <Label text="Lý do báo cáo:" styleClass="caption,admin-party-label"/>
                        <Label fx:id="reportReason" id="reportReason" wrapText="true" styleClass="admin-reason-text"/>
                    </VBox>
                </VBox>

                <HBox spacing="8" alignment="CENTER_LEFT" styleClass="admin-notice-banner,admin-e2ee-banner">
                    <FontIcon iconLiteral="fth-info" iconSize="16" styleClass="admin-notice-icon"/>
                    <Label text="Lưu ý kiểm duyệt: Bản rõ bằng chứng do người báo cáo gửi kèm từ thiết bị cá nhân (tối đa 20 tin vi phạm &amp; 30 tin ngữ cảnh). Hệ thống không lưu khóa giải mã E2EE gốc (DEC-05, DEC-10)."
                           minWidth="0" maxWidth="Infinity" minHeight="-Infinity" wrapText="true" styleClass="caption" HBox.hgrow="ALWAYS"/>
                </HBox>

                <VBox spacing="10" minWidth="0">
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <FontIcon iconLiteral="fth-message-circle" iconSize="14" styleClass="admin-section-icon"/>
                        <Label fx:id="evidenceCountLabel" id="evidenceCountLabel" text="Bằng chứng đính kèm" styleClass="admin-subsection-title"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <HBox spacing="6" alignment="CENTER_RIGHT">
                            <Label text="Bị báo cáo" styleClass="admin-evidence-tag,tag-selected"/>
                            <Label text="Ngữ cảnh" styleClass="admin-evidence-tag,tag-context"/>
                        </HBox>
                    </HBox>

                    <VBox fx:id="chatPreviewList" id="chatPreviewList" spacing="8" minWidth="0" styleClass="admin-chat-preview-container"/>
                </VBox>

                <VBox spacing="12" minWidth="0" styleClass="admin-moderation-actions">
                    <Label text="Thao tác kiểm duyệt" styleClass="admin-subsection-title"/>
                    <Label text="Khóa tài khoản và đánh dấu đã xử lý là hai thao tác độc lập (DEC-10, BR-04)."
                           styleClass="caption" wrapText="true"/>

                    <Button fx:id="lockAccountButton" id="lockReportedUser" text="Khóa tài khoản bị báo cáo"
                            onAction="#openLockConfirmation" maxWidth="Infinity" styleClass="admin-profile-destructive">
                        <graphic><FontIcon fx:id="lockIcon" iconLiteral="fth-lock" iconSize="16"/></graphic>
                    </Button>

                    <VBox fx:id="pendingReviewBox" spacing="8">
                        <Label text="Đánh dấu đã xử lý (DEC-10):" styleClass="caption"/>
                        <TextField fx:id="reviewNoteField" id="reviewNoteField" promptText="Ghi chú xử lý (bắt buộc)..."/>
                        <Label fx:id="reviewNoteError" styleClass="caption,admin-error-text" visible="false" managed="false"/>
                        <Button fx:id="markReviewedButton" id="markReviewed" text="Đánh dấu đã xử lý"
                                onAction="#markReviewed" maxWidth="Infinity" styleClass="admin-user-primary">
                            <graphic><FontIcon iconLiteral="fth-check" iconSize="16"/></graphic>
                        </Button>
                    </VBox>

                    <VBox fx:id="reviewedBox" spacing="6" styleClass="admin-reviewed-banner" visible="false" managed="false">
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <FontIcon iconLiteral="fth-check-circle" iconSize="16" styleClass="admin-reviewed-icon"/>
                            <Label fx:id="reviewedHeader" id="reviewedHeader" styleClass="admin-reviewed-header" wrapText="true"/>
                        </HBox>
                        <Label fx:id="reviewedNoteText" id="reviewedNoteText" styleClass="caption,admin-reviewed-note" wrapText="true"/>
                    </VBox>
                </VBox>
            </VBox>
        </ScrollPane>
    </StackPane>
</SplitPane>
