<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<VBox xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.chatsystem.admin.controller.analytics.AnalyticsFiltersController"
      spacing="12" minWidth="0" styleClass="admin-analytics-filters">
    <fx:define>
        <ToggleGroup fx:id="comparison"/>
    </fx:define>
    <FlowPane hgap="8" vgap="8" rowValignment="BOTTOM" prefWrapLength="690" minWidth="0">
        <VBox fx:id="fromField" spacing="4">
            <Label text="Từ ngày" styleClass="caption"/>
            <DatePicker fx:id="fromDate" prefWidth="128" editable="false" accessibleText="Từ ngày"/>
        </VBox>
        <VBox fx:id="toField" spacing="4">
            <Label text="Đến ngày" styleClass="caption"/>
            <DatePicker fx:id="toDate" prefWidth="128" editable="false" accessibleText="Đến ngày"/>
        </VBox>
        <VBox spacing="4">
            <Label text="Họ tên" styleClass="caption"/>
            <TextField fx:id="nameFilter" prefWidth="156" accessibleText="Lọc theo họ tên"/>
        </VBox>
        <VBox spacing="4">
            <Label text="Sắp xếp" styleClass="caption"/>
            <ComboBox fx:id="accountSort" prefWidth="150" accessibleText="Sắp xếp tài khoản"/>
        </VBox>
        <HBox alignment="BOTTOM_LEFT" spacing="8" minWidth="0">
            <FlowPane fx:id="countFilters" hgap="12" vgap="8" rowValignment="BOTTOM"
                      minWidth="0" maxWidth="-Infinity" visible="false" managed="false">
                <VBox fx:id="metricField" spacing="4">
                    <Label text="Chỉ số hoạt động" styleClass="caption"/>
                    <ComboBox fx:id="activityMetric" prefWidth="176" accessibleText="Chỉ số hoạt động"/>
                </VBox>
                <VBox spacing="4">
                    <Label fx:id="comparisonLabel" text="Toán tử" styleClass="caption"/>
                    <HBox spacing="4" styleClass="admin-analytics-operators">
                        <ToggleButton fx:id="equalTo" text="=" toggleGroup="$comparison" selected="true"
                                      accessibleText="Bằng"/>
                        <ToggleButton id="lessThan" text="&lt;" toggleGroup="$comparison" accessibleText="Nhỏ hơn"/>
                        <ToggleButton id="greaterThan" text="&gt;" toggleGroup="$comparison" accessibleText="Lớn hơn"/>
                    </HBox>
                </VBox>
                <VBox spacing="4">
                    <Label text="Giá trị ngưỡng" styleClass="caption"/>
                    <TextField fx:id="threshold" prefWidth="104" promptText="Chưa lọc"
                               accessibleText="Giá trị ngưỡng"/>
                </VBox>
            </FlowPane>
            <Button id="clearAnalyticsFilters" text="Bỏ bộ lọc" onAction="#clearFilters"
                    styleClass="admin-analytics-reset"/>
        </HBox>
    </FlowPane>
    <Label fx:id="filterError" text="Chọn ngày bắt đầu và ngày kết thúc theo đúng thứ tự"
           styleClass="admin-analytics-filter-error" visible="false" managed="false" wrapText="true"/>
</VBox>
