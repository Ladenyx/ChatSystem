<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<VBox xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.chatsystem.admin.controller.dialogs.ConfirmActionController"
      fx:id="confirmation" spacing="16" minWidth="312" prefWidth="452" styleClass="admin-user-dialog-content">
    <Label fx:id="confirmationTitle" text="Xác nhận thao tác" styleClass="admin-user-dialog-title" wrapText="true"/>
    <VBox spacing="4" styleClass="admin-dialog-account">
        <Label fx:id="account" text="Chọn tài khoản để tiếp tục" styleClass="admin-dialog-account-name" wrapText="true"/>
        <Label fx:id="accountId" styleClass="caption,admin-dialog-account-id" wrapText="true"/>
        <Label fx:id="recipient" styleClass="caption" wrapText="true" managed="false" visible="false"/>
    </VBox>
    <Label fx:id="consequences" wrapText="true"/>
</VBox>
