<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<BorderPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.chatsystem.admin.controller.auth.SignInController"
            styleClass="admin-sign-in" stylesheets="@../../css/sign-in.css">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12" fillHeight="false" styleClass="toolbar">
            <StackPane styleClass="admin-brand-icon">
                <FontIcon iconLiteral="fth-message-square" iconSize="16" mouseTransparent="true"/>
            </StackPane>
            <Label text="WhatsUp" styleClass="brand"/>
            <Label text="Admin App" styleClass="caption"/>
        </HBox>
    </top>
    <center>
        <StackPane styleClass="admin-sign-in-content">
            <VBox id="signInForm" spacing="24" minWidth="0" prefWidth="464" maxWidth="464" maxHeight="-Infinity"
                  styleClass="admin-sign-in-form">
                <Label text="Đăng nhập quản trị" styleClass="page-title" wrapText="true"/>
                <VBox spacing="16">
                    <VBox spacing="8">
                        <fx:define><TextField fx:id="signInUsername" minWidth="0"/></fx:define>
                        <Label text="Tên đăng nhập" labelFor="$signInUsername" styleClass="admin-sign-in-label"/>
                        <fx:reference source="signInUsername"/>
                    </VBox>
                    <VBox spacing="8">
                        <fx:define><PasswordField fx:id="signInPassword" minWidth="0"/></fx:define>
                        <Label text="Mật khẩu" labelFor="$signInPassword" styleClass="admin-sign-in-label"/>
                        <fx:reference source="signInPassword"/>
                    </VBox>
                </VBox>
                <VBox spacing="12" alignment="CENTER">
                    <Button fx:id="signInSubmit" text="Đăng nhập" defaultButton="true" onAction="#openOverview"
                            maxWidth="Infinity" styleClass="admin-sign-in-submit"/>
                </VBox>
            </VBox>
        </StackPane>
    </center>
</BorderPane>
