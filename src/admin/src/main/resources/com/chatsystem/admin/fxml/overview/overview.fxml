<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<ScrollPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.chatsystem.admin.controller.overview.OverviewController"
            fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER" minWidth="0" focusTraversable="false"
            styleClass="admin-overview" stylesheets="@../../css/overview.css">
    <VBox spacing="16" minWidth="0" styleClass="admin-overview-content">
        <GridPane hgap="4" minWidth="0" styleClass="admin-kpi-strip">
            <columnConstraints>
                <ColumnConstraints percentWidth="25"/>
                <ColumnConstraints percentWidth="25"/>
                <ColumnConstraints percentWidth="25"/>
                <ColumnConstraints percentWidth="25"/>
            </columnConstraints>
            <Button fx:id="totalUsersCard" onAction="#openUsers" styleClass="admin-kpi"
                    accessibleText="Tổng người dùng" accessibleHelp="Mở danh sách người dùng"
                    minWidth="0" maxWidth="Infinity" maxHeight="Infinity">
                <graphic>
                    <VBox spacing="4" minWidth="0">
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label text="Tổng người dùng" styleClass="admin-kpi-label"/>
                            <FontIcon iconLiteral="fth-arrow-up-right" iconSize="16"/>
                        </HBox>
                        <Label fx:id="totalUsersValue" styleClass="admin-kpi-value"/>
                    </VBox>
                </graphic>
            </Button>
            <Button fx:id="onlineUsersCard" onAction="#openUsers" styleClass="admin-kpi"
                    accessibleText="Đang trực tuyến" accessibleHelp="Mở danh sách người dùng"
                    minWidth="0" maxWidth="Infinity" maxHeight="Infinity" GridPane.columnIndex="1">
                <graphic>
                    <VBox spacing="4" minWidth="0">
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label text="Đang trực tuyến" styleClass="admin-kpi-label"/>
                            <FontIcon iconLiteral="fth-arrow-up-right" iconSize="16"/>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label fx:id="onlineUsersValue" styleClass="admin-kpi-value"/>
                            <Region fx:id="onlineIndicator" styleClass="admin-online-indicator"/>
                        </HBox>
                    </VBox>
                </graphic>
            </Button>
            <Button fx:id="totalGroupsCard" onAction="#openGroups" styleClass="admin-kpi"
                    accessibleText="Tổng nhóm chat" accessibleHelp="Mở danh sách nhóm chat"
                    minWidth="0" maxWidth="Infinity" maxHeight="Infinity" GridPane.columnIndex="2">
                <graphic>
                    <VBox spacing="4" minWidth="0">
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label text="Tổng nhóm chat" styleClass="admin-kpi-label"/>
                            <FontIcon iconLiteral="fth-arrow-up-right" iconSize="16"/>
                        </HBox>
                        <Label fx:id="totalGroupsValue" styleClass="admin-kpi-value"/>
                    </VBox>
                </graphic>
            </Button>
            <Button fx:id="pendingSpamCard" onAction="#openSpam" styleClass="admin-kpi"
                    accessibleText="Báo cáo spam chờ xử lý" accessibleHelp="Mở danh sách báo cáo spam"
                    minWidth="0" maxWidth="Infinity" maxHeight="Infinity" GridPane.columnIndex="3">
                <graphic>
                    <VBox spacing="4" minWidth="0">
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label text="Spam chờ xử lý" styleClass="admin-kpi-label"/>
                            <FontIcon iconLiteral="fth-arrow-up-right" iconSize="16"/>
                        </HBox>
                        <Label fx:id="pendingSpamValue" styleClass="admin-kpi-value"/>
                    </VBox>
                </graphic>
            </Button>
        </GridPane>

        <VBox spacing="8" styleClass="admin-overview-panel" minWidth="0" maxHeight="576" VBox.vgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT" spacing="8">
                <Label fx:id="trendTitle" styleClass="section-title" wrapText="true"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Hyperlink id="registrationsLink" text="Đăng ký mới →" onAction="#openRegistrations"
                           accessibleText="Mở thống kê đăng ký mới"/>
                <Hyperlink id="activityLink" text="Hoạt động →" onAction="#openActivity"
                           accessibleText="Mở thống kê hoạt động người dùng"/>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="16" styleClass="admin-trend-legend">
                <Label fx:id="registrationsLegend" styleClass="caption">
                    <graphic><StackPane styleClass="chart-line-symbol,default-color0"/></graphic>
                </Label>
                <Label fx:id="activityLegend" styleClass="caption">
                    <graphic><StackPane styleClass="chart-line-symbol,default-color1"/></graphic>
                </Label>
            </HBox>
            <LineChart fx:id="monthlyTrend" animated="false" createSymbols="true" legendVisible="false"
                       prefHeight="196" minHeight="144" minWidth="0" VBox.vgrow="ALWAYS"
                       alternativeRowFillVisible="false" verticalGridLinesVisible="false"
                       accessibleText="Xu hướng đăng ký mới và số người mở ứng dụng theo từng tháng">
                <xAxis>
                    <CategoryAxis gapStartAndEnd="false" startMargin="8" endMargin="8"
                                  tickMarkVisible="false" animated="false"/>
                </xAxis>
                <yAxis>
                    <NumberAxis autoRanging="false" lowerBound="0" minorTickVisible="false"
                                tickMarkVisible="false" animated="false"/>
                </yAxis>
            </LineChart>
        </VBox>

        <GridPane hgap="16" minWidth="0">
            <columnConstraints>
                <ColumnConstraints percentWidth="50"/>
                <ColumnConstraints percentWidth="50"/>
            </columnConstraints>
            <VBox spacing="8" styleClass="admin-overview-panel" minWidth="0">
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label text="Báo cáo spam mới nhất" styleClass="section-title" wrapText="true"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Hyperlink id="allReportsLink" text="Xem tất cả →" onAction="#openSpam"
                               accessibleText="Xem tất cả báo cáo spam"/>
                </HBox>
                <TableView fx:id="recentReports" fixedCellSize="32" minHeight="132" prefHeight="132"
                           minWidth="0" styleClass="admin-summary-table"
                           accessibleText="Báo cáo spam mới nhất">
                    <columns>
                        <TableColumn fx:id="reportedAccount" text="Bị báo cáo" prefWidth="96"
                                     minWidth="76" sortable="false" reorderable="false"/>
                        <TableColumn fx:id="reporterAccount" text="Người báo cáo" prefWidth="116"
                                     minWidth="96" sortable="false" reorderable="false"/>
                        <TableColumn fx:id="reportedAt" text="Thời gian gửi" minWidth="116"
                                     sortable="false" reorderable="false"/>
                    </columns>
                    <placeholder>
                        <Label text="Chưa có báo cáo spam" styleClass="secondary-text"/>
                    </placeholder>
                </TableView>
            </VBox>
            <VBox spacing="8" styleClass="admin-overview-panel" minWidth="0" GridPane.columnIndex="1">
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label text="Lượt đăng nhập gần đây" styleClass="section-title" wrapText="true"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Hyperlink id="allLoginsLink" text="Xem tất cả →" onAction="#openLoginLogs"
                               accessibleText="Xem tất cả lượt đăng nhập"/>
                </HBox>
                <TableView fx:id="recentLogins" fixedCellSize="32" minHeight="132" prefHeight="132"
                           minWidth="0" styleClass="admin-summary-table"
                           accessibleText="Lượt đăng nhập gần đây">
                    <columns>
                        <TableColumn fx:id="loginUsername" text="Tên đăng nhập" prefWidth="112"
                                     minWidth="104" sortable="false" reorderable="false"/>
                        <TableColumn fx:id="loginFullName" text="Họ tên" prefWidth="148"
                                     minWidth="104" sortable="false" reorderable="false"/>
                        <TableColumn fx:id="loggedInAt" text="Đăng nhập lúc" minWidth="116"
                                     sortable="false" reorderable="false"/>
                    </columns>
                    <placeholder>
                        <Label text="Chưa có lượt đăng nhập" styleClass="secondary-text"/>
                    </placeholder>
                </TableView>
            </VBox>
        </GridPane>
    </VBox>
</ScrollPane>
