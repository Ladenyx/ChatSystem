<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<BorderPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.chatsystem.admin.controller.AdminShellController"
            styleClass="admin-shell" stylesheets="@../css/admin-shell.css">
    <left>
        <VBox fx:id="workspaceSidebar" styleClass="sidebar">
            <HBox alignment="CENTER_LEFT" spacing="12" styleClass="admin-brand">
                <StackPane styleClass="admin-brand-icon">
                    <FontIcon iconLiteral="fth-message-square" iconSize="20"/>
                </StackPane>
                <Label text="WhatsUp" styleClass="brand"/>
            </HBox>
            <VBox fx:id="overviewNav" spacing="4"/>
            <Label text="Quản trị và kiểm duyệt" styleClass="nav-group"/>
            <VBox fx:id="managementNav" spacing="4"/>
            <Label text="Phân tích và thống kê" styleClass="nav-group"/>
            <VBox fx:id="analyticsNav" spacing="4"/>
            <Region VBox.vgrow="ALWAYS"/>
            <VBox spacing="4" styleClass="admin-sidebar-footer">
                <Button fx:id="displayButton" id="displayOptions" text="Giao diện" onAction="#openDisplayOptions"
                        maxWidth="Infinity" styleClass="admin-shell-action">
                    <graphic><FontIcon iconLiteral="fth-monitor" iconSize="16"/></graphic>
                </Button>
                <Button text="Thoát ứng dụng" onAction="#exit" maxWidth="Infinity" styleClass="admin-shell-action">
                    <graphic><FontIcon iconLiteral="fth-log-out" iconSize="16"/></graphic>
                </Button>
            </VBox>
        </VBox>
    </left>
    <center>
        <BorderPane>
            <top>
                <HBox fx:id="workspaceToolbar" alignment="CENTER_LEFT" spacing="12" styleClass="toolbar">
                    <Button fx:id="backButton" id="goBack" onAction="#goBack" accessibleText="Quay lại"
                            styleClass="admin-shell-action">
                        <graphic><FontIcon iconLiteral="fth-arrow-left" iconSize="16"/></graphic>
                        <tooltip><Tooltip text="Quay lại (Alt + ←)"/></tooltip>
                    </Button>
                    <Label fx:id="pageTitle" styleClass="admin-page-title" wrapText="true"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="overviewDataNote" text="Dữ liệu mẫu" styleClass="caption"/>
                </HBox>
            </top>
            <center><StackPane fx:id="viewHost" id="viewHost" minWidth="0"/></center>
        </BorderPane>
    </center>
</BorderPane>
