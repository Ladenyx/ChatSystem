<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<BorderPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:id="drawerLayout" fx:controller="com.chatsystem.user.controller.messaging.ConversationInfoController"
            styleClass="chat-info" stylesheets="@../../css/chat-tokens.css,@../../css/chat.css" minWidth="0">
    <fx:define>
        <VBox fx:id="searchPane" styleClass="chat-drawer-search" spacing="12" minWidth="0">
            <StackPane alignment="CENTER_LEFT" styleClass="chat-search">
                <TextField fx:id="conversationSearchField" id="conversationSearchField" promptText="Tìm trong đoạn chat"
                           accessibleText="Từ khóa trong đoạn chat"/>
                <FontIcon iconLiteral="fth-search" iconSize="15" styleClass="chat-search-icon" mouseTransparent="true">
                    <StackPane.margin><Insets left="12"/></StackPane.margin>
                </FontIcon>
            </StackPane>
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Label fx:id="resultCount" id="localResultCount" wrapText="true" minWidth="0" maxWidth="Infinity"
                       styleClass="chat-caption" HBox.hgrow="ALWAYS"/>
                <Button fx:id="previousResult" id="previousSearchResult" onAction="#previous"
                        styleClass="chat-outline,chat-result-nav" accessibleText="Kết quả trước">
                    <graphic><FontIcon iconLiteral="fth-chevron-up" iconSize="15"/></graphic>
                    <tooltip><Tooltip text="Kết quả trước"/></tooltip>
                </Button>
                <Button fx:id="nextResult" id="nextSearchResult" onAction="#next"
                        styleClass="chat-outline,chat-result-nav" accessibleText="Kết quả sau">
                    <graphic><FontIcon iconLiteral="fth-chevron-down" iconSize="15"/></graphic>
                    <tooltip><Tooltip text="Kết quả sau"/></tooltip>
                </Button>
            </HBox>
            <ScrollPane fx:id="localResultScroll" fitToWidth="true" hbarPolicy="NEVER" styleClass="chat-search-scroll"
                        VBox.vgrow="ALWAYS">
                <VBox fx:id="localResults" spacing="8" minWidth="0"/>
            </ScrollPane>
        </VBox>
    </fx:define>
    <top>
        <HBox alignment="CENTER_LEFT" spacing="8" styleClass="chat-info-header">
            <Button fx:id="back" id="drawerBack" onAction="#showInfo" visible="false"
                    accessibleText="Về thông tin đoạn chat" styleClass="chat-drawer-icon">
                <graphic><FontIcon iconLiteral="fth-arrow-left" iconSize="16"/></graphic>
                <tooltip><Tooltip text="Quay lại"/></tooltip>
            </Button>
            <Label fx:id="heading" id="drawerHeading" wrapText="true" minWidth="0" maxWidth="Infinity"
                   styleClass="chat-result-title" HBox.hgrow="ALWAYS"/>
            <Button id="drawerClose" onAction="#close" accessibleText="Đóng panel" styleClass="chat-drawer-icon">
                <graphic><FontIcon iconLiteral="fth-x" iconSize="16"/></graphic>
                <tooltip><Tooltip text="Đóng (Esc)"/></tooltip>
            </Button>
        </HBox>
    </top>
    <center>
        <ScrollPane fx:id="infoPane" fitToWidth="true" hbarPolicy="NEVER" styleClass="chat-search-scroll">
            <VBox fx:id="infoContent" spacing="0" minWidth="0"/>
        </ScrollPane>
    </center>
</BorderPane>
