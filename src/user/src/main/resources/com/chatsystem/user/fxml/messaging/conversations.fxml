<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<BorderPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:id="workspace" fx:controller="com.chatsystem.user.controller.messaging.ConversationsController"
            styleClass="chat-workspace" focusTraversable="true" minWidth="0">
    <fx:define><ToggleGroup fx:id="filters"/></fx:define>
    <left>
        <VBox fx:id="conversationSidebar" id="conversationSidebar" styleClass="chat-sidebar" minWidth="280" maxWidth="384">
            <VBox spacing="12" styleClass="chat-sidebar-top">
                <HBox alignment="CENTER_LEFT" spacing="8" styleClass="chat-sidebar-header">
                    <Label text="Đoạn chat" styleClass="chat-heading" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                    <Button id="createGroup" text="Nhóm mới" onAction="#createGroup" accessibleText="Tạo nhóm mới"
                            styleClass="chat-action-btn">
                        <graphic><FontIcon iconLiteral="fth-plus" iconSize="14"/></graphic>
                        <tooltip><Tooltip text="Tạo nhóm mới"/></tooltip>
                    </Button>
                </HBox>
                <VBox spacing="8">
                    <StackPane alignment="CENTER_LEFT" styleClass="chat-search">
                        <TextField fx:id="conversationFilter" promptText="Tìm kiếm"
                                   accessibleText="Lọc hội thoại theo tên"/>
                        <FontIcon iconLiteral="fth-search" iconSize="15" styleClass="chat-search-icon"
                                  mouseTransparent="true">
                            <StackPane.margin><Insets left="12"/></StackPane.margin>
                        </FontIcon>
                    </StackPane>
                    <HBox spacing="4" styleClass="chat-filter-bar">
                        <ToggleButton fx:id="allFilter" text="Tất cả" toggleGroup="$filters"
                                      styleClass="chat-filter-tab" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                        <ToggleButton fx:id="unreadFilter" text="Chưa đọc" toggleGroup="$filters"
                                      styleClass="chat-filter-tab" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                        <ToggleButton fx:id="groupFilter" text="Nhóm" toggleGroup="$filters"
                                      styleClass="chat-filter-tab" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                    </HBox>
                </VBox>
            </VBox>
            <ListView fx:id="conversationItems" id="conversationItems" accessibleText="Danh sách đoạn chat"
                      styleClass="chat-list" VBox.vgrow="ALWAYS">
                <placeholder><Label text="Không có đoạn chat phù hợp" wrapText="true" styleClass="chat-caption"/></placeholder>
            </ListView>
        </VBox>
    </left>
    <center>
        <StackPane id="chatWorkspace" minWidth="0">
            <VBox fx:id="emptyWorkspace" id="emptyWorkspace" alignment="CENTER" spacing="16" styleClass="chat-empty">
                <StackPane styleClass="chat-empty-icon">
                    <FontIcon iconLiteral="fth-message-square" iconSize="22"/>
                </StackPane>
                <VBox alignment="CENTER" spacing="6" maxWidth="340">
                    <Label text="Chọn một đoạn chat" styleClass="chat-empty-title" wrapText="true" textAlignment="CENTER"/>
                    <Label text="Chọn cuộc trò chuyện bên trái hoặc tạo nhóm mới để bắt đầu trao đổi"
                           styleClass="chat-empty-subtitle" wrapText="true" textAlignment="CENTER"/>
                </VBox>
                <Button text="Tạo nhóm mới" onAction="#createGroup" styleClass="chat-primary-btn">
                    <graphic><FontIcon iconLiteral="fth-plus" iconSize="15"/></graphic>
                </Button>
                <HBox alignment="CENTER" spacing="6" styleClass="chat-empty-note">
                    <FontIcon iconLiteral="fth-lock" iconSize="12"/>
                    <Label text="Nhóm chat được bảo vệ bằng mã hóa đầu cuối" styleClass="chat-caption"/>
                </HBox>
            </VBox>
            <fx:include fx:id="selectedWorkspace" source="chat-history.fxml"/>
        </StackPane>
    </center>
</BorderPane>
