<?xml version="1.0" encoding="UTF-8"?>
<?import com.chatsystem.user.control.ChatIcon?>
<?import com.chatsystem.user.control.ConversationAvatar?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>
<BorderPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.chatsystem.user.controller.chat.ChatHistoryController"
            visible="false" styleClass="chat-selected" minWidth="0">
    <top>
        <StackPane>
            <HBox fx:id="normalHeader" alignment="CENTER_LEFT" spacing="12" styleClass="chat-header">
                <ConversationAvatar fx:id="conversationAvatar"/>
                <VBox spacing="4" minWidth="0" HBox.hgrow="ALWAYS">
                    <Label fx:id="conversationTitle" styleClass="chat-heading" wrapText="true"/>
                    <Label fx:id="conversationStatus" styleClass="chat-caption" wrapText="true"/>
                </VBox>
                <Button id="conversationInfo" onAction="#openInfo" accessibleText="Thông tin đoạn chat"
                        styleClass="chat-outline,chat-info-button">
                    <graphic><ChatIcon icon="info"/></graphic>
                    <tooltip><Tooltip text="Thông tin đoạn chat"/></tooltip>
                </Button>
            </HBox>
        </StackPane>
    </top>
    <center>
        <VBox minWidth="0">
            <VBox fx:id="historyNotice" styleClass="chat-history-notice"/>
            <ScrollPane fx:id="historyScroll" id="historyScroll" fitToWidth="true" hbarPolicy="NEVER"
                        styleClass="chat-history" accessibleText="Lịch sử tin nhắn" VBox.vgrow="ALWAYS">
                <VBox fx:id="messageRows" id="messageRows" spacing="12" minWidth="0" styleClass="chat-history-content"/>
            </ScrollPane>
        </VBox>
    </center>
    <bottom>
        <HBox fx:id="composer" alignment="CENTER_LEFT" spacing="8" fillHeight="false" styleClass="chat-composer">
            <TextArea fx:id="draftField" id="draftField" promptText="Nhập tin nhắn" wrapText="true"
                      prefRowCount="2" prefHeight="56" minWidth="0" HBox.hgrow="ALWAYS" accessibleText="Soạn tin nhắn"/>
            <Button fx:id="aiAssistantButton" onAction="#openAssistant"
                    accessibleText="Mở gợi ý soạn tin bằng AI" styleClass="chat-outline,chat-ai-trigger">
                <graphic>
                    <Region styleClass="chat-icon" mouseTransparent="true">
                        <shape>
                            <SVGPath content="M8 4 Q9 11 16 12 Q9 13 8 20 Q7 13 0 12 Q7 11 8 4 Z
                                              M18 0 Q18.75 5.25 24 6 Q18.75 6.75 18 12 Q17.25 6.75 12 6 Q17.25 5.25 18 0 Z
                                              M17 16 Q17.5 19.5 21 20 Q17.5 20.5 17 24 Q16.5 20.5 13 20 Q16.5 19.5 17 16 Z"/>
                        </shape>
                    </Region>
                </graphic>
                <tooltip><Tooltip text="Gợi ý soạn tin bằng AI"/></tooltip>
            </Button>
            <Button fx:id="sendButton" id="sendMessage" disable="true" accessibleText="Gửi tin nhắn"
                    styleClass="chat-primary,chat-composer-icon,chat-send">
                <graphic><ChatIcon icon="send"/></graphic>
                <tooltip><Tooltip text="Gửi (Enter)"/></tooltip>
            </Button>
        </HBox>
    </bottom>
</BorderPane>
