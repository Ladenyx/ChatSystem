<?xml version="1.0" encoding="UTF-8"?>
<?import com.chatsystem.user.control.ChatIcon?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<VBox xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.chatsystem.user.controller.ai.AiAssistantController"
      id="aiAssistant" styleClass="chat-ai-pane" spacing="12"
      stylesheets="@../css/chat-tokens.css,@../css/chat.css">
    <HBox alignment="CENTER_LEFT" spacing="8">
        <Label fx:id="heading" id="aiHeading" styleClass="chat-heading" maxWidth="Infinity" minWidth="0"
               wrapText="true" HBox.hgrow="ALWAYS"/>
        <Button id="aiClose" styleClass="chat-drawer-icon" accessibleText="Đóng trợ lý AI" onAction="#close">
            <graphic><ChatIcon icon="drawer-close"/></graphic>
        </Button>
    </HBox>
    <Label text="Demo ngoại tuyến · Không gửi dữ liệu qua mạng" styleClass="chat-caption" wrapText="true"/>
    <ScrollPane fx:id="scroll" fitToWidth="true" hbarPolicy="NEVER" styleClass="chat-search-scroll">
        <VBox fx:id="body" minWidth="0" spacing="10"/>
    </ScrollPane>
    <VBox fx:id="disclosure" spacing="6" minWidth="0"/>
    <HBox fx:id="footer" alignment="CENTER_LEFT" spacing="8"/>
</VBox>
