<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<VBox xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:id="hero"
      alignment="CENTER" spacing="20" prefWidth="460" maxWidth="520" minWidth="0"
      styleClass="auth-illustration-pane">
    <ImageView fitWidth="${hero.width}" fitHeight="320" preserveRatio="true" smooth="true" mouseTransparent="true">
        <image><Image url="@../../images/auth-illustration.png"/></image>
    </ImageView>
    <VBox alignment="CENTER" spacing="8" maxWidth="420">
        <Label text="Nhắn tin trực tiếp và trò chuyện nhóm"
               styleClass="auth-hero-title" wrapText="true" textAlignment="CENTER"/>
        <HBox alignment="CENTER" spacing="6" styleClass="auth-hero-note">
            <FontIcon iconLiteral="fth-lock" iconSize="12"/>
            <Label text="Nhóm chat được bảo vệ bằng mã hóa đầu cuối" styleClass="auth-hero-caption"/>
        </HBox>
    </VBox>
</VBox>
