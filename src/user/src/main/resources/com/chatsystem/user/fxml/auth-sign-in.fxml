<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<ScrollPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.chatsystem.user.controller.auth.SignInController"
            id="authSignIn" styleClass="auth-view" stylesheets="@../css/auth.css" fitToWidth="true"
            fitToHeight="true" hbarPolicy="NEVER" focusTraversable="false">
    <content>
        <StackPane styleClass="auth-layout">
            <HBox alignment="CENTER" styleClass="auth-columns">
                <fx:include source="auth-illustration.fxml" HBox.hgrow="ALWAYS"/>
                <VBox alignment="CENTER" minWidth="330" prefWidth="522" maxWidth="522" fillWidth="true"
                      styleClass="auth-card-column">
                    <VBox fillWidth="true" styleClass="auth-card">
                        <Label text="Đăng nhập" styleClass="auth-heading" wrapText="true"/>
                        <VBox spacing="6">
                            <Label text="Tên đăng nhập" styleClass="auth-field-label"/>
                            <TextField fx:id="authSignInUsername" promptText="Tên đăng nhập" accessibleText="Tên đăng nhập"
                                       onAction="#submit"/>
                            <Label fx:id="authSignInUsernameError" labelFor="$authSignInUsername" visible="false"
                                   managed="false" wrapText="true" styleClass="auth-error,auth-inline-error"/>
                        </VBox>
                        <VBox spacing="6">
                            <Label text="Mật khẩu" styleClass="auth-field-label"/>
                            <StackPane styleClass="auth-password-input">
                                <PasswordField fx:id="authSignInPassword" promptText="Mật khẩu" accessibleText="Mật khẩu" onAction="#submit"/>
                                <TextField fx:id="authSignInPasswordVisible" promptText="Mật khẩu" accessibleText="Mật khẩu" onAction="#submit"
                                           visible="false" managed="false"/>
                                <Button fx:id="authSignInShowPassword" text="Hiện" accessibleText="Hiện mật khẩu"
                                        styleClass="auth-password-toggle" StackPane.alignment="CENTER_RIGHT" contentDisplay="GRAPHIC_ONLY">
                                    <graphic>
                                        <ImageView fitWidth="18" fitHeight="18" preserveRatio="true" mouseTransparent="true">
                                            <image><Image url="@../images/auth-visibility-off.png"/></image>
                                        </ImageView>
                                    </graphic>
                                </Button>
                            </StackPane>
                            <Label fx:id="authSignInPasswordError" labelFor="$authSignInPassword" visible="false"
                                   managed="false" wrapText="true" styleClass="auth-error,auth-inline-error"/>
                        </VBox>
                        <Label fx:id="authSignInFeedback" visible="false" managed="false" wrapText="true" focusTraversable="false" styleClass="auth-error"/>
                        <HBox alignment="CENTER_RIGHT">
                            <Button fx:id="authOpenForgotPassword" text="Quên mật khẩu?" onAction="#openForgotPassword" styleClass="auth-link"/>
                        </HBox>
                        <Button fx:id="authSignInSubmit" text="Đăng nhập" onAction="#submit" defaultButton="true" maxWidth="Infinity" styleClass="auth-primary"/>
                        <HBox alignment="CENTER" spacing="4">
                            <Label text="Chưa có tài khoản?" styleClass="auth-muted"/>
                            <Button fx:id="authOpenSignUp" text="Tạo tài khoản" onAction="#openSignUp" styleClass="auth-link,auth-neutral-link"/>
                        </HBox>
                    </VBox>
                </VBox>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="12" maxHeight="54" translateY="46" mouseTransparent="true"
                  StackPane.alignment="TOP_CENTER" styleClass="auth-header">
                <ImageView fitWidth="54" fitHeight="54" preserveRatio="true">
                    <image><Image url="@../images/auth-app-mark.png"/></image>
                </ImageView>
                <Label text="Xem trước ngoại tuyến" styleClass="auth-preview-badge"/>
            </HBox>
        </StackPane>
    </content>
</ScrollPane>
