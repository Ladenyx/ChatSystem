<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<BorderPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:id="contactsRoot" fx:controller="com.chatsystem.user.controller.contacts.ContactsController"
            stylesheets="@../../css/contacts.css" styleClass="user-contacts" minWidth="0">
    <fx:define>
        <ToggleGroup fx:id="contactsTabs"/>
    </fx:define>
    <left>
        <VBox prefWidth="248" spacing="0" styleClass="contacts-sidebar">
            <VBox styleClass="contacts-sidebar-top">
                <Label text="Bạn bè &amp; Kết nối" wrapText="true" styleClass="contacts-heading"/>
            </VBox>
            <VBox spacing="4" styleClass="contacts-sidebar-nav">
                <ToggleButton fx:id="contactsTabAll" text="Tất cả bạn bè" toggleGroup="$contactsTabs"
                              maxWidth="Infinity" styleClass="contacts-nav" accessibleText="Tất cả bạn bè">
                    <graphic><FontIcon iconLiteral="fth-users" iconSize="16" mouseTransparent="true"/></graphic>
                </ToggleButton>
                <ToggleButton fx:id="contactsTabOnline" text="Đang online" toggleGroup="$contactsTabs"
                              maxWidth="Infinity" styleClass="contacts-nav" accessibleText="Đang online">
                    <graphic><FontIcon iconLiteral="fth-activity" iconSize="16" mouseTransparent="true"/></graphic>
                </ToggleButton>
                <ToggleButton fx:id="contactsTabRequests" text="Lời mời kết bạn" toggleGroup="$contactsTabs"
                              maxWidth="Infinity" styleClass="contacts-nav" accessibleText="Lời mời kết bạn">
                    <graphic><FontIcon iconLiteral="fth-user-plus" iconSize="16" mouseTransparent="true"/></graphic>
                </ToggleButton>
                <ToggleButton fx:id="contactsTabSearch" text="Tìm người dùng" toggleGroup="$contactsTabs"
                              maxWidth="Infinity" styleClass="contacts-nav" accessibleText="Tìm người dùng">
                    <graphic><FontIcon iconLiteral="fth-search" iconSize="16" mouseTransparent="true"/></graphic>
                </ToggleButton>
                <ToggleButton fx:id="contactsTabBlocked" text="Đã chặn" toggleGroup="$contactsTabs"
                              maxWidth="Infinity" styleClass="contacts-nav" accessibleText="Đã chặn">
                    <graphic><FontIcon iconLiteral="fth-slash" iconSize="16" mouseTransparent="true"/></graphic>
                </ToggleButton>
            </VBox>
        </VBox>
    </left>
    <center>
        <VBox spacing="16" styleClass="contacts-content" minWidth="0">
            <HBox spacing="12" alignment="BASELINE_LEFT">
                <Label fx:id="contactsTitle" styleClass="contacts-page-title"
                       maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                <Label fx:id="contactsCount" styleClass="contacts-count"/>
            </HBox>
            <StackPane fx:id="contactsSearchRow" alignment="CENTER_LEFT" styleClass="contacts-search">
                <TextField fx:id="contactsFilter"/>
                <FontIcon iconLiteral="fth-search" iconSize="15" styleClass="contacts-search-icon"
                          mouseTransparent="true">
                    <StackPane.margin><Insets left="12"/></StackPane.margin>
                </FontIcon>
            </StackPane>
            <ScrollPane fx:id="contactsScroll" fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS"
                        accessibleText="Danh sách kết nối" styleClass="contacts-scroll">
                <content><VBox fx:id="contactsList" spacing="0" minWidth="0"/></content>
            </ScrollPane>
            <VBox spacing="8" styleClass="contacts-footer">
                <Label fx:id="contactsStatus" visible="false" managed="false" wrapText="true"
                       maxWidth="Infinity" styleClass="contacts-status"/>
                <Label fx:id="contactsNote" wrapText="true" maxWidth="Infinity" styleClass="contacts-note"/>
            </VBox>
        </VBox>
    </center>
</BorderPane>
