<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<ScrollPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.chatsystem.user.controller.auth.KeySetupController"
            id="keySetupView" styleClass="key-view" stylesheets="@../../css/e2ee-key-setup.css"
            fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER" minWidth="0">
    <content>
        <StackPane styleClass="key-content">
            <VBox alignment="CENTER" spacing="18" maxWidth="480" maxHeight="-Infinity" styleClass="key-card">
                <StackPane styleClass="key-icon" maxWidth="44" maxHeight="44">
                    <FontIcon iconLiteral="fth-lock" iconSize="22" mouseTransparent="true"/>
                </StackPane>
                <Label text="Thiết lập và khôi phục khóa E2EE" styleClass="key-title"
                       wrapText="true" textAlignment="CENTER"/>
                <Label text="Dùng mã 6 số để sao lưu hoặc khôi phục khóa trò chuyện khi đổi thiết bị."
                       styleClass="secondary-text" wrapText="true" textAlignment="CENTER"/>

                <VBox fx:id="choices" alignment="CENTER" spacing="12">
                    <Button id="keyCreate" text="Thiết lập mã" onAction="#setup"
                            styleClass="key-primary,accent" prefWidth="260"/>
                    <Button id="keyRestore" text="Khôi phục bằng mã" onAction="#restore"
                            styleClass="key-secondary" prefWidth="260"/>
                    <Button id="keySkip" text="Bỏ qua" onAction="#cancel"
                            styleClass="key-escape" prefWidth="260"/>
                </VBox>

                <VBox fx:id="codeForm" alignment="CENTER" spacing="14" visible="false" managed="false">
                    <Label fx:id="formTitle" styleClass="section-title" wrapText="true" textAlignment="CENTER"/>
                    <Label fx:id="formHelp" styleClass="secondary-text" wrapText="true" textAlignment="CENTER"/>
                    <VBox spacing="8" maxWidth="376">
                        <Label text="Mã khôi phục" styleClass="key-label"/>
                        <HBox fx:id="digitRow" spacing="8" alignment="CENTER_LEFT"/>
                    </VBox>
                    <VBox fx:id="confirmationGroup" spacing="8" maxWidth="376">
                        <Label text="Nhập lại mã khôi phục" styleClass="key-label"/>
                        <HBox fx:id="confirmRow" spacing="8" alignment="CENTER_LEFT"/>
                    </VBox>
                    <Label fx:id="notice" styleClass="key-notice" wrapText="true" textAlignment="CENTER"/>
                    <Button fx:id="keySubmit" onAction="#submit" styleClass="key-primary,accent" prefWidth="260"/>
                    <Button id="keyCancel" text="Hủy" onAction="#cancel" styleClass="key-escape" prefWidth="260"/>
                </VBox>
            </VBox>
        </StackPane>
    </content>
</ScrollPane>
