<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<ScrollPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.chatsystem.user.controller.auth.ForceChangePasswordController"
            id="authForceChangePassword" styleClass="auth-view" stylesheets="@../../css/auth.css" fitToWidth="true"
            fitToHeight="true" hbarPolicy="NEVER" focusTraversable="false">
    <content>
        <BorderPane styleClass="auth-layout">
            <top><fx:include source="auth-header.fxml"/></top>
            <center>
                <HBox alignment="CENTER" styleClass="auth-columns">
                    <fx:include source="auth-illustration.fxml" HBox.hgrow="ALWAYS"/>
                    <VBox alignment="CENTER" minWidth="360" prefWidth="440" maxWidth="440" fillWidth="true"
                          styleClass="auth-card-column">
                        <VBox fillWidth="true" styleClass="auth-card">
                            <VBox spacing="8">
                                <HBox alignment="CENTER_LEFT" spacing="12">
                                    <Label fx:id="forceTitle" text="Xác nhận mật khẩu tạm"
                                           styleClass="auth-heading" wrapText="true"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Label fx:id="stepCounter" minWidth="-Infinity" styleClass="auth-step-counter"/>
                                </HBox>
                                <HBox fx:id="stepProgress" spacing="4" styleClass="auth-progress">
                                    <Region styleClass="auth-progress-segment" HBox.hgrow="ALWAYS"/>
                                    <Region styleClass="auth-progress-segment" HBox.hgrow="ALWAYS"/>
                                </HBox>
                                <Label fx:id="stepTitle" visible="false" managed="false"
                                       styleClass="auth-subtitle" wrapText="true"/>
                                <Label fx:id="stepHelp" styleClass="auth-muted" wrapText="true"/>
                            </VBox>
                            <VBox fx:id="temporaryStep" spacing="4">
                                <Label text="Mật khẩu tạm" styleClass="auth-field-label"/>
                                <StackPane styleClass="auth-password-input">
                                    <PasswordField fx:id="authTemporaryPassword" promptText="Nhập mật khẩu tạm"
                                                   accessibleText="Mật khẩu tạm" onAction="#submit"/>
                                    <TextField fx:id="visibleTemporaryPassword" promptText="Nhập mật khẩu tạm"
                                               accessibleText="Mật khẩu tạm" onAction="#submit"
                                               visible="false" managed="false"/>
                                    <Button fx:id="showTemporaryPassword" text="Hiện"
                                            accessibleText="Hiện mật khẩu" styleClass="auth-password-toggle"
                                            StackPane.alignment="CENTER_RIGHT" contentDisplay="GRAPHIC_ONLY">
                                        <StackPane.margin><Insets right="4"/></StackPane.margin>
                                        <graphic>
                                            <FontIcon iconLiteral="fth-eye-off" iconSize="16"
                                                      mouseTransparent="true"/>
                                        </graphic>
                                    </Button>
                                </StackPane>
                                <Label fx:id="authTemporaryPasswordError" labelFor="$authTemporaryPassword"
                                       visible="false" managed="false" wrapText="true"
                                       styleClass="auth-error,auth-inline-error"/>
                            </VBox>
                            <VBox fx:id="passwordStep" spacing="12" visible="false" managed="false">
                                <VBox spacing="4">
                                    <Label text="Mật khẩu mới" styleClass="auth-field-label"/>
                                    <StackPane styleClass="auth-password-input">
                                        <PasswordField fx:id="authNewPassword" promptText="Nhập mật khẩu mới"
                                                       accessibleText="Mật khẩu mới" onAction="#submit"/>
                                        <TextField fx:id="visibleNewPassword" promptText="Nhập mật khẩu mới"
                                                   accessibleText="Mật khẩu mới" onAction="#submit"
                                                   visible="false" managed="false"/>
                                        <Button fx:id="showNewPassword" text="Hiện"
                                                accessibleText="Hiện mật khẩu" styleClass="auth-password-toggle"
                                                StackPane.alignment="CENTER_RIGHT" contentDisplay="GRAPHIC_ONLY">
                                            <StackPane.margin><Insets right="4"/></StackPane.margin>
                                            <graphic>
                                                <FontIcon iconLiteral="fth-eye-off" iconSize="16"
                                                          mouseTransparent="true"/>
                                            </graphic>
                                        </Button>
                                    </StackPane>
                                    <Label fx:id="authNewPasswordError" labelFor="$authNewPassword"
                                           visible="false" managed="false" wrapText="true"
                                           styleClass="auth-error,auth-inline-error"/>
                                    <GridPane hgap="12" vgap="4" styleClass="auth-rules">
                                        <columnConstraints>
                                            <ColumnConstraints percentWidth="50"/>
                                            <ColumnConstraints percentWidth="50"/>
                                        </columnConstraints>
                                        <Label fx:id="ruleLength" text="8–128 ký tự" wrapText="true"
                                               graphicTextGap="8">
                                            <graphic><Region styleClass="auth-rule-dot"/></graphic>
                                        </Label>
                                        <Label fx:id="ruleUpper" text="Có chữ hoa" wrapText="true"
                                               graphicTextGap="8" GridPane.columnIndex="1">
                                            <graphic><Region styleClass="auth-rule-dot"/></graphic>
                                        </Label>
                                        <Label fx:id="ruleLower" text="Có chữ thường" wrapText="true"
                                               graphicTextGap="8" GridPane.rowIndex="1">
                                            <graphic><Region styleClass="auth-rule-dot"/></graphic>
                                        </Label>
                                        <Label fx:id="ruleDigit" text="Có chữ số" wrapText="true"
                                               graphicTextGap="8" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                            <graphic><Region styleClass="auth-rule-dot"/></graphic>
                                        </Label>
                                        <Label fx:id="ruleSymbol" text="Có ký tự đặc biệt" wrapText="true"
                                               graphicTextGap="8" GridPane.rowIndex="2">
                                            <graphic><Region styleClass="auth-rule-dot"/></graphic>
                                        </Label>
                                    </GridPane>
                                </VBox>
                                <VBox spacing="4">
                                    <Label text="Nhập lại mật khẩu" styleClass="auth-field-label"/>
                                    <StackPane styleClass="auth-password-input">
                                        <PasswordField fx:id="authConfirmNewPassword"
                                                       promptText="Nhập lại mật khẩu"
                                                       accessibleText="Nhập lại mật khẩu" onAction="#submit"/>
                                        <TextField fx:id="visibleConfirmation" promptText="Nhập lại mật khẩu"
                                                   accessibleText="Nhập lại mật khẩu" onAction="#submit"
                                                   visible="false" managed="false"/>
                                        <Button fx:id="showConfirmation" text="Hiện"
                                                accessibleText="Hiện mật khẩu" styleClass="auth-password-toggle"
                                                StackPane.alignment="CENTER_RIGHT" contentDisplay="GRAPHIC_ONLY">
                                            <StackPane.margin><Insets right="4"/></StackPane.margin>
                                            <graphic>
                                                <FontIcon iconLiteral="fth-eye-off" iconSize="16"
                                                          mouseTransparent="true"/>
                                            </graphic>
                                        </Button>
                                    </StackPane>
                                    <Label fx:id="authConfirmNewPasswordError"
                                           labelFor="$authConfirmNewPassword" visible="false" managed="false"
                                           wrapText="true" styleClass="auth-error,auth-inline-error"/>
                                </VBox>
                            </VBox>
                            <Label fx:id="formError" visible="false" managed="false" wrapText="true"
                                   focusTraversable="false" styleClass="auth-error"/>
                            <Button fx:id="authForceContinue" text="Xác nhận" onAction="#submit"
                                    defaultButton="true" maxWidth="Infinity" styleClass="auth-primary"/>
                            <Button fx:id="authForceCancel" text="Quay lại đăng nhập"
                                    accessibleText="Quay lại đăng nhập" onAction="#cancel"
                                    graphicTextGap="6" styleClass="auth-link,auth-back">
                                <graphic><FontIcon iconLiteral="fth-arrow-left" iconSize="14"/></graphic>
                            </Button>
                        </VBox>
                    </VBox>
                </HBox>
            </center>
        </BorderPane>
    </content>
</ScrollPane>
