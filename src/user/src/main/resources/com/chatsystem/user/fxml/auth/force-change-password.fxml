<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<ScrollPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.chatsystem.user.controller.auth.ForceChangePasswordController"
            id="authForceChangePassword" styleClass="auth-view" stylesheets="@../../css/auth.css" fitToWidth="true"
            fitToHeight="true" hbarPolicy="NEVER" focusTraversable="false">
    <content>
        <StackPane styleClass="auth-layout">
            <HBox alignment="CENTER" styleClass="auth-columns">
                <fx:include source="auth-illustration.fxml" HBox.hgrow="ALWAYS"/>
                <VBox alignment="CENTER" minWidth="330" prefWidth="522" maxWidth="522" fillWidth="true"
                      styleClass="auth-card-column">
                    <VBox fillWidth="true" styleClass="auth-card">
                        <VBox spacing="6">
                            <Label fx:id="forceTitle" text="Xác nhận mật khẩu tạm" styleClass="auth-heading" wrapText="true"/>
                            <Label fx:id="stepTitle" visible="false" managed="false" styleClass="auth-subtitle" wrapText="true"/>
                            <Label fx:id="stepHelp" styleClass="auth-muted" wrapText="true"/>
                        </VBox>
                        <VBox fx:id="temporaryStep" spacing="6">
                            <Label text="Mật khẩu tạm" styleClass="auth-field-label"/>
                            <StackPane styleClass="auth-password-input">
                                <PasswordField fx:id="authTemporaryPassword" promptText="Mật khẩu tạm" accessibleText="Mật khẩu tạm" onAction="#submit"/>
                                <TextField fx:id="visibleTemporaryPassword" promptText="Mật khẩu tạm" accessibleText="Mật khẩu tạm" onAction="#submit"
                                           visible="false" managed="false"/>
                                <Button fx:id="showTemporaryPassword" text="Hiện" accessibleText="Hiện mật khẩu"
                                        styleClass="auth-password-toggle" StackPane.alignment="CENTER_RIGHT" contentDisplay="GRAPHIC_ONLY">
                                    <graphic>
                                        <ImageView fitWidth="18" fitHeight="18" preserveRatio="true" mouseTransparent="true">
                                            <image><Image url="@../../images/auth-visibility-off.png"/></image>
                                        </ImageView>
                                    </graphic>
                                </Button>
                            </StackPane>
                            <Label fx:id="authTemporaryPasswordError" labelFor="$authTemporaryPassword" visible="false"
                                   managed="false" wrapText="true" styleClass="auth-error,auth-inline-error"/>
                        </VBox>
                        <VBox fx:id="passwordStep" spacing="6" visible="false" managed="false">
                            <Label text="Mật khẩu mới" styleClass="auth-field-label"/>
                            <StackPane styleClass="auth-password-input">
                                <PasswordField fx:id="authNewPassword" promptText="Mật khẩu mới" accessibleText="Mật khẩu mới" onAction="#submit"/>
                                <TextField fx:id="visibleNewPassword" promptText="Mật khẩu mới" accessibleText="Mật khẩu mới" onAction="#submit"
                                           visible="false" managed="false"/>
                                <Button fx:id="showNewPassword" text="Hiện" accessibleText="Hiện mật khẩu"
                                        styleClass="auth-password-toggle" StackPane.alignment="CENTER_RIGHT" contentDisplay="GRAPHIC_ONLY">
                                    <graphic>
                                        <ImageView fitWidth="18" fitHeight="18" preserveRatio="true" mouseTransparent="true">
                                            <image><Image url="@../../images/auth-visibility-off.png"/></image>
                                        </ImageView>
                                    </graphic>
                                </Button>
                            </StackPane>
                            <Label fx:id="authNewPasswordError" labelFor="$authNewPassword" visible="false"
                                   managed="false" wrapText="true" styleClass="auth-error,auth-inline-error"/>
                            <GridPane hgap="8" vgap="3" styleClass="auth-rules">
                                <columnConstraints>
                                    <ColumnConstraints percentWidth="50"/>
                                    <ColumnConstraints percentWidth="50"/>
                                </columnConstraints>
                                <Label fx:id="ruleLength" text="○ 8–128 ký tự" styleClass="auth-muted" wrapText="true"/>
                                <Label fx:id="ruleUpper" text="○ Có chữ hoa" styleClass="auth-muted" wrapText="true" GridPane.columnIndex="1"/>
                                <Label fx:id="ruleLower" text="○ Có chữ thường" styleClass="auth-muted" wrapText="true" GridPane.rowIndex="1"/>
                                <Label fx:id="ruleDigit" text="○ Có chữ số" styleClass="auth-muted" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                                <Label fx:id="ruleSymbol" text="○ Có ký tự đặc biệt" styleClass="auth-muted" wrapText="true" GridPane.rowIndex="2"/>
                            </GridPane>
                            <Label text="Nhập lại mật khẩu" styleClass="auth-field-label"/>
                            <StackPane styleClass="auth-password-input">
                                <PasswordField fx:id="authConfirmNewPassword" promptText="Nhập lại mật khẩu" accessibleText="Nhập lại mật khẩu" onAction="#submit"/>
                                <TextField fx:id="visibleConfirmation" promptText="Nhập lại mật khẩu" accessibleText="Nhập lại mật khẩu" onAction="#submit"
                                           visible="false" managed="false"/>
                                <Button fx:id="showConfirmation" text="Hiện" accessibleText="Hiện mật khẩu"
                                        styleClass="auth-password-toggle" StackPane.alignment="CENTER_RIGHT" contentDisplay="GRAPHIC_ONLY">
                                    <graphic>
                                        <ImageView fitWidth="18" fitHeight="18" preserveRatio="true" mouseTransparent="true">
                                            <image><Image url="@../../images/auth-visibility-off.png"/></image>
                                        </ImageView>
                                    </graphic>
                                </Button>
                            </StackPane>
                            <Label fx:id="authConfirmNewPasswordError" labelFor="$authConfirmNewPassword" visible="false"
                                   managed="false" wrapText="true" styleClass="auth-error,auth-inline-error"/>
                        </VBox>
                        <Label fx:id="formError" visible="false" managed="false" wrapText="true" focusTraversable="false" styleClass="auth-error"/>
                        <Button fx:id="authForceContinue" text="Xác nhận" onAction="#submit" defaultButton="true" maxWidth="Infinity" styleClass="auth-primary"/>
                        <Button fx:id="authForceCancel" text="‹ Quay lại đăng nhập" accessibleText="Quay lại đăng nhập"
                                onAction="#cancel" styleClass="auth-link,auth-back"/>
                    </VBox>
                </VBox>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="12" maxHeight="54" translateY="46" mouseTransparent="true"
                  StackPane.alignment="TOP_CENTER" styleClass="auth-header">
                <ImageView fitWidth="54" fitHeight="54" preserveRatio="true">
                    <image><Image url="@../../images/auth-app-mark.png"/></image>
                </ImageView>
                <Label text="Xem trước ngoại tuyến" styleClass="auth-preview-badge"/>
            </HBox>
        </StackPane>
    </content>
</ScrollPane>
