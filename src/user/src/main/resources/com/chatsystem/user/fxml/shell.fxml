<?xml version="1.0" encoding="UTF-8"?>
<?import atlantafx.base.controls.ToggleSwitch?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<BorderPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.chatsystem.user.controller.UserShellController"
            styleClass="user-shell" stylesheets="@../css/chat-tokens.css,@../css/chat.css">
    <fx:define>
        <VBox fx:id="settingsContent" id="settingsContent" styleClass="rail-settings" spacing="4" prefWidth="256">
            <Label text="Cài đặt" styleClass="rail-settings-heading"/>
            <ToggleSwitch fx:id="darkModeSwitch" text="Chế độ tối" labelPosition="LEFT" maxWidth="Infinity">
                <VBox.margin><Insets left="8" right="8" bottom="4"/></VBox.margin>
            </ToggleSwitch>
            <Button id="openProfile" text="Hồ sơ &amp; Bảo mật" onAction="#openProfile"
                    styleClass="rail-settings-item" maxWidth="Infinity">
                <graphic><FontIcon iconLiteral="fth-user" iconSize="15"/></graphic>
            </Button>
        </VBox>
    </fx:define>
    <left>
        <VBox fx:id="workspaceRail" id="workspaceRail" styleClass="rail,chat-rail">
            <StackPane styleClass="chat-brand-mark" accessibleText="WhatsUp">
                <FontIcon iconLiteral="fth-message-square" iconSize="20"/>
            </StackPane>
            <VBox spacing="4" alignment="TOP_CENTER" styleClass="chat-rail-group">
                <ToggleButton fx:id="chatsButton" id="navChats" text="Chat" styleClass="nav-item"
                              onAction="#openChats" accessibleText="Đoạn chat">
                    <graphic><FontIcon iconLiteral="fth-message-square" iconSize="18"/></graphic>
                    <tooltip><Tooltip text="Đoạn chat"/></tooltip>
                </ToggleButton>
                <ToggleButton fx:id="contactsButton" id="navContacts" text="Bạn bè" styleClass="nav-item"
                              onAction="#openContacts" accessibleText="Bạn bè và kết nối">
                    <graphic><FontIcon iconLiteral="fth-users" iconSize="18"/></graphic>
                    <tooltip><Tooltip text="Bạn bè &amp; Kết nối"/></tooltip>
                </ToggleButton>
                <Button fx:id="backButton" id="goBack" styleClass="nav-item,chat-rail-back" onAction="#goBack"
                        accessibleText="Quay lại">
                    <graphic><FontIcon iconLiteral="fth-arrow-left" iconSize="16"/></graphic>
                    <tooltip><Tooltip text="Quay lại (Alt + ←)"/></tooltip>
                </Button>
            </VBox>
            <Region VBox.vgrow="ALWAYS"/>
            <VBox spacing="4" alignment="BOTTOM_CENTER" styleClass="chat-rail-footer">
                <Button fx:id="settingsButton" id="workspaceSettings" text="Cài đặt" styleClass="nav-item"
                        accessibleText="Cài đặt" onAction="#openSettings">
                    <graphic><FontIcon iconLiteral="fth-settings" iconSize="18"/></graphic>
                </Button>
                <Button id="signOut" text="Thoát" styleClass="nav-item" onAction="#signOut"
                        accessibleText="Đăng xuất">
                    <graphic><FontIcon iconLiteral="fth-log-out" iconSize="18"/></graphic>
                    <tooltip><Tooltip text="Đăng xuất"/></tooltip>
                </Button>
            </VBox>
        </VBox>
    </left>
    <center><StackPane fx:id="viewHost" id="viewHost" minWidth="0"/></center>
</BorderPane>
