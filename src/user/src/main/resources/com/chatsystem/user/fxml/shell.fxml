<?xml version="1.0" encoding="UTF-8"?>
<?import atlantafx.base.controls.ToggleSwitch?>
<?import com.chatsystem.user.control.ChatIcon?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<BorderPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.chatsystem.user.controller.UserShellController"
            styleClass="user-shell" stylesheets="@../css/chat-tokens.css,@../css/chat.css">
    <fx:define>
        <VBox fx:id="settingsContent" id="settingsContent" styleClass="rail-settings" spacing="6" prefWidth="300">
            <Label text="Cài đặt" styleClass="rail-settings-heading"/>
            <ToggleSwitch fx:id="darkModeSwitch" text="Chế độ tối" labelPosition="RIGHT">
                <VBox.margin><Insets top="4" bottom="4" left="12"/></VBox.margin>
            </ToggleSwitch>
            <Button id="openProfile" text="Hồ sơ &amp; Bảo mật" onAction="#openProfile"
                    styleClass="rail-settings-item" maxWidth="Infinity"/>
            <Button id="displayOptions" text="Tùy chọn hiển thị" onAction="#openDisplayOptions"
                    styleClass="rail-settings-item" maxWidth="Infinity"/>
            <Button id="openMockData" text="Xem dữ liệu mẫu" onAction="#openMockData"
                    styleClass="rail-settings-item" maxWidth="Infinity"/>
        </VBox>
    </fx:define>
    <left>
        <VBox fx:id="workspaceRail" id="workspaceRail" styleClass="rail,chat-rail">
            <Label text="CS" styleClass="app-mark"/>
            <ToggleButton fx:id="chatsButton" id="navChats" text="Đoạn chat" styleClass="nav-item"
                          onAction="#openChats" accessibleText="Đoạn chat">
                <graphic><ChatIcon icon="chat"/></graphic>
            </ToggleButton>
            <ToggleButton fx:id="contactsButton" id="navContacts" text="Bạn bè" styleClass="nav-item"
                          onAction="#openContacts" accessibleText="Bạn bè và kết nối">
                <graphic><ChatIcon icon="users"/></graphic>
            </ToggleButton>
            <Button fx:id="backButton" id="goBack" styleClass="nav-item" onAction="#goBack" accessibleText="Quay lại">
                <graphic><FontIcon iconLiteral="fth-arrow-left" iconSize="16"/></graphic>
                <tooltip><Tooltip text="Quay lại (Alt + ←)"/></tooltip>
            </Button>
            <Region VBox.vgrow="ALWAYS"/>
            <Button fx:id="settingsButton" id="workspaceSettings" text="Cài đặt" styleClass="nav-item"
                    accessibleText="Cài đặt" onAction="#openSettings">
                <graphic><ChatIcon icon="settings"/></graphic>
            </Button>
            <Button id="signOut" text="Đăng xuất" styleClass="nav-item" onAction="#signOut">
                <graphic><ChatIcon icon="logout"/></graphic>
                <tooltip><Tooltip text="Kết thúc phiên và đóng bản demo ngoại tuyến"/></tooltip>
            </Button>
        </VBox>
    </left>
    <center><StackPane fx:id="viewHost" id="viewHost" minWidth="0"/></center>
</BorderPane>
