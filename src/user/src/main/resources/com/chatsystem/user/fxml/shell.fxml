<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<BorderPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.chatsystem.user.controller.UserShellController">
    <left>
        <VBox styleClass="rail">
            <Label text="CS" styleClass="app-mark"/>
            <ToggleButton fx:id="chatsButton" id="navChats" text="Đoạn chat" styleClass="nav-item"
                          onAction="#openChats" accessibleText="Đoạn chat">
                <graphic><FontIcon iconLiteral="fth-message-square" iconSize="20"/></graphic>
            </ToggleButton>
            <ToggleButton fx:id="contactsButton" id="navContacts" text="Bạn bè" styleClass="nav-item"
                          onAction="#openContacts" accessibleText="Bạn bè và kết nối">
                <graphic><FontIcon iconLiteral="fth-users" iconSize="20"/></graphic>
            </ToggleButton>
            <Region VBox.vgrow="ALWAYS"/>
            <Button fx:id="themeButton" id="toggleTheme" text="Sáng" styleClass="nav-item" onAction="#toggleTheme"/>
            <Button id="openProfile" text="Hồ sơ" styleClass="nav-item" onAction="#openProfile">
                <graphic><FontIcon iconLiteral="fth-settings" iconSize="20"/></graphic>
            </Button>
            <Button text="Thoát" styleClass="nav-item" onAction="#exit" accessibleText="Đóng User Client">
                <graphic><FontIcon iconLiteral="fth-log-out" iconSize="20"/></graphic>
            </Button>
        </VBox>
    </left>
    <center>
        <BorderPane>
            <top>
                <HBox alignment="CENTER_LEFT" spacing="16" styleClass="toolbar">
                    <Button fx:id="backButton" id="goBack" onAction="#goBack" accessibleText="Quay lại">
                        <graphic><FontIcon iconLiteral="fth-arrow-left" iconSize="18"/></graphic>
                        <tooltip><Tooltip text="Quay lại (Alt + ←)"/></tooltip>
                    </Button>
                    <Label text="ChatSystem" styleClass="brand"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="Bản xem giao diện · Ngoại tuyến" styleClass="offline-badge"/>
                    <Button fx:id="displayButton" id="displayOptions" text="Hiển thị" onAction="#openDisplayOptions"/>
                </HBox>
            </top>
            <center><StackPane fx:id="viewHost" id="viewHost" minWidth="0"/></center>
        </BorderPane>
    </center>
</BorderPane>
