<?xml version="1.0" encoding="UTF-8"?>
<?import com.chatsystem.user.control.ConversationAvatar?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<VBox xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.chatsystem.user.controller.chat.ConversationInfoController"
      styleClass="chat-info" spacing="8" stylesheets="@../css/chat-tokens.css,@../css/chat.css">
    <ConversationAvatar fx:id="avatar"/>
    <Label fx:id="title" styleClass="page-title" wrapText="true"/>
    <Label fx:id="status" styleClass="secondary-text" wrapText="true"/>
</VBox>
