<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<ScrollPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.chatsystem.user.controller.auth.ForgotPasswordController"
            id="authForgotPassword" styleClass="auth-view" stylesheets="@../../css/auth.css" fitToWidth="true"
            fitToHeight="true" hbarPolicy="NEVER" focusTraversable="false">
    <content>
        <StackPane styleClass="auth-layout">
            <HBox alignment="CENTER" styleClass="auth-columns">
                <fx:include source="auth-illustration.fxml" HBox.hgrow="ALWAYS"/>
                <VBox alignment="CENTER" minWidth="330" prefWidth="522" maxWidth="522" fillWidth="true"
                      styleClass="auth-card-column">
                    <VBox fillWidth="true" styleClass="auth-card">
                        <VBox spacing="6">
                            <Label text="Quên mật khẩu" styleClass="auth-heading" wrapText="true"/>
                            <Label fx:id="stepTitle" styleClass="auth-subtitle" wrapText="true"/>
                        </VBox>
                        <VBox fx:id="usernameStep" spacing="6">
                            <Label text="Tên đăng nhập" styleClass="auth-field-label"/>
                            <TextField fx:id="authForgotUsername" promptText="Tên đăng nhập" accessibleText="Tên đăng nhập" onAction="#submit"/>
                            <Label fx:id="authForgotUsernameError" labelFor="$authForgotUsername" visible="false"
                                   managed="false" wrapText="true" styleClass="auth-error,auth-inline-error"/>
                        </VBox>
                        <VBox fx:id="emailStep" spacing="6" visible="false" managed="false">
                            <Label fx:id="authForgotMaskedEmail" wrapText="true" styleClass="auth-muted"/>
                            <Label text="Email" styleClass="auth-field-label"/>
                            <TextField fx:id="authForgotEmail" promptText="Nhập email liên kết" accessibleText="Email" onAction="#submit"/>
                            <Label fx:id="authForgotEmailError" labelFor="$authForgotEmail" visible="false"
                                   managed="false" wrapText="true" styleClass="auth-error,auth-inline-error"/>
                        </VBox>
                        <VBox fx:id="checkEmailStep" spacing="8" visible="false" managed="false">
                            <Label fx:id="stepHelp" styleClass="auth-muted" wrapText="true"/>
                            <Button fx:id="authForgotResend" text="Gửi lại" disable="true" styleClass="auth-link"/>
                        </VBox>
                        <Label fx:id="formError" visible="false" managed="false" wrapText="true" focusTraversable="false" styleClass="auth-error"/>
                        <Button fx:id="authForgotContinue" text="Tiếp tục" onAction="#submit" defaultButton="true" maxWidth="Infinity" styleClass="auth-primary"/>
                        <Button fx:id="authForgotCancel" text="‹ Quay lại đăng nhập" accessibleText="Quay lại đăng nhập"
                                onAction="#cancel" styleClass="auth-link,auth-back"/>
                    </VBox>
                </VBox>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="12" maxHeight="54" translateY="46" mouseTransparent="true"
                  StackPane.alignment="TOP_CENTER" styleClass="auth-header">
                <ImageView fitWidth="54" fitHeight="54" preserveRatio="true">
                    <image><Image url="@../../images/auth-app-mark.png"/></image>
                </ImageView>
                <Label text="Xem trước ngoại tuyến" styleClass="auth-preview-badge"/>
            </HBox>
        </StackPane>
    </content>
</ScrollPane>
